# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Application URL
APP_URL=http://localhost:3000
NODE_ENV=development

# OTP & Verification
OTP_PROVIDER=mock
OTP_DEVELOPMENT_MODE=true

# Supabase Storage Buckets
STORAGE_BUCKET_VISITORS=visitor-media
STORAGE_BUCKET_COMPLAINTS=complaint-media
STORAGE_BUCKET_BILLS=billing-documents

# Online Payment Gateway (Stage 6)
PAYMENT_GATEWAY_PROVIDER=MOCK
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
PAYMENT_WEBHOOK_SECRET=your-webhook-cryptographic-secret
